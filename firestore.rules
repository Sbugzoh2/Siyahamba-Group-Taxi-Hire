rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // A real account (Google or email), not the automatic browse-only one. Accounts follow people to new phones.
    function permanent() { return signedIn() && request.auth.token.firebase.get('sign_in_provider', '') != 'anonymous'; }
    // Owners are listed in the "admins" collection (added by hand in the Firebase console).
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function driverDoc(id) { return /databases/$(database)/documents/drivers/$(id); }
    function requestDoc(id) { return /databases/$(database)/documents/requests/$(id); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Siyahamba's fee: 10% of the trip price. Keep this in step with COMMISSION_PCT in index.html.
    function feeFor(fare) { return fare / 10; }
    // A driver's own changes always leave them "incomplete" or "pending" review, never approved.
    function notApprovedAfter(id) { return getAfter(driverDoc(id)).data.get('vetting', 'incomplete') in ['incomplete', 'pending']; }

    match /admins/{id} {
      allow read: if signedIn() && uid() == id;
      allow write: if false;
    }

    // ---------------- Trip requests ----------------
    match /requests/{id} {
      allow read: if signedIn();

      // A passenger creates a request in their own name, as "open", with no driver, fee or payment progress.
      allow create: if permanent()
        && request.resource.data.requesterId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.fare is number && request.resource.data.fare > 0
        && request.resource.data.get('payStatus', 'unpaid') == 'unpaid'
        && !request.resource.data.keys().hasAny(['commission', 'driverId', 'heldAt', 'releasedAt', 'refundedAt', 'passengerConfirmed', 'issue', 'commissionDecision']);

      allow update: if isAdmin() || passengerCancels() || passengerClaimsPaid() || passengerConfirms() || passengerReports()
        || driverAccepts() || driverMovesOn() || driverGivesBack();
      allow delete: if isAdmin();

      function isPassenger() { return resource.data.requesterId == uid(); }

      function passengerCancels() {
        return isPassenger()
          && resource.data.status in ['open', 'accepted']
          && request.resource.data.status == 'cancelled'
          && changed().hasOnly(['status', 'updatedAt']);
      }
      // "I've paid": only the owner can later mark the money as received.
      function passengerClaimsPaid() {
        return isPassenger()
          && resource.data.get('payMode', '') == 'secure'
          && resource.data.get('payStatus', '') == 'unpaid'
          && resource.data.status != 'cancelled'
          && request.resource.data.payStatus == 'claimed'
          && changed().hasOnly(['payStatus', 'paidClaimAt', 'updatedAt']);
      }
      // "We arrived safely": the passenger's half of releasing the payment.
      function passengerConfirms() {
        return isPassenger()
          && resource.data.status == 'completed'
          && request.resource.data.passengerConfirmed == true
          && changed().hasOnly(['passengerConfirmed', 'updatedAt']);
      }
      // "Report a problem": stops the payment from being released until the owner decides.
      function passengerReports() {
        return isPassenger()
          && resource.data.get('payStatus', '') in ['claimed', 'held']
          && request.resource.data.payStatus == 'disputed'
          && request.resource.data.issue is string && request.resource.data.issue.size() <= 1000
          && changed().hasOnly(['payStatus', 'issue', 'updatedAt']);
      }

      // Accepting a job: approved drivers only, paying exactly 10% from their own credit in the same write.
      function driverAccepts() {
        return permanent()
          && resource.data.status == 'open'
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverId == uid()
          && request.resource.data.commission == feeFor(resource.data.fare)
          && changed().hasOnly(['status', 'driverId', 'driverName', 'driverPhone', 'driverVehicle', 'driverReg', 'acceptedAt', 'commission', 'updatedAt'])
          && exists(driverDoc(uid()))
          && get(driverDoc(uid())).data.get('vetting', '') == 'approved'
          && getAfter(driverDoc(uid())).data.credit == get(driverDoc(uid())).data.credit - feeFor(resource.data.fare)
          && getAfter(driverDoc(uid())).data.credit >= 0;
      }

      function driverMovesOn() {
        return resource.data.driverId == uid()
          && changed().hasOnly(['status', 'updatedAt'])
          && ((resource.data.status == 'accepted' && request.resource.data.status == 'enroute')
            || (resource.data.status == 'enroute' && request.resource.data.status == 'ontrip')
            || (resource.data.status == 'ontrip' && request.resource.data.status == 'completed'));
      }

      // Giving a job back reopens it and returns the fee to the driver's credit.
      function driverGivesBack() {
        return resource.data.driverId == uid()
          && resource.data.status == 'accepted'
          && request.resource.data.status == 'open'
          && request.resource.data.driverId == null
          && request.resource.data.commission == null
          && changed().hasOnly(['status', 'driverId', 'driverName', 'driverPhone', 'driverVehicle', 'driverReg', 'commission', 'updatedAt'])
          && getAfter(driverDoc(uid())).data.credit == get(driverDoc(uid())).data.credit + resource.data.get('commission', 0);
      }
    }

    // ---------------- Driver accounts (private: the driver and owners only) ----------------
    match /drivers/{id} {
      allow read: if signedIn() && (uid() == id || isAdmin());
      allow create: if isAdmin() || (permanent() && uid() == id
        && request.resource.data.credit == 0
        && request.resource.data.get('vetting', 'incomplete') in ['incomplete', 'pending']
        && request.resource.data.keys().hasOnly(openKeys().concat(identityKeys()).concat(['credit', 'code', 'createdAt'])));
      allow update: if isAdmin() || (signedIn() && uid() == id && (profileEdit() || payForJob() || refundForJob()));
      allow delete: if isAdmin();

      // Fields a driver can change at any time.
      function openKeys() { return ['phone', 'assoc', 'race', 'updatedAt']; }
      // Fields the owner checks. Changing any of them sends the driver back for review.
      function identityKeys() {
        return ['name', 'idType', 'idNumber', 'nationality', 'vehicle', 'reg', 'pdp',
          'bankName', 'bankHolder', 'bankAccount', 'bankBranch', 'docs', 'vetting', 'submittedAt', 'consentAt'];
      }
      function profileEdit() {
        return changed().hasOnly(openKeys().concat(identityKeys()))
          && (!changed().hasAny(identityKeys()) || request.resource.data.get('vetting', 'incomplete') in ['incomplete', 'pending']);
      }
      function payForJob() {
        let job = request.resource.data.lastJob;
        return changed().hasOnly(['credit', 'lastJob', 'updatedAt'])
          && get(requestDoc(job)).data.status == 'open'
          && getAfter(requestDoc(job)).data.status == 'accepted'
          && getAfter(requestDoc(job)).data.driverId == uid()
          && request.resource.data.credit == resource.data.credit - getAfter(requestDoc(job)).data.commission
          && request.resource.data.credit >= 0;
      }
      function refundForJob() {
        let job = request.resource.data.lastJob;
        return changed().hasOnly(['credit', 'lastJob', 'updatedAt'])
          && get(requestDoc(job)).data.status == 'accepted'
          && get(requestDoc(job)).data.driverId == uid()
          && getAfter(requestDoc(job)).data.status == 'open'
          && request.resource.data.credit == resource.data.credit + get(requestDoc(job)).data.get('commission', 0);
      }
    }

    // ID copy, driver's licence and PrDP: the driver and owners only.
    match /driverFiles/{id}/files/{kind} {
      allow read: if signedIn() && (uid() == id || isAdmin());
      allow write: if isAdmin() || (signedIn() && uid() == id
        && kind in ['idCopy', 'licence', 'prdp']
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000
        && notApprovedAfter(id));
    }

    // What passengers may see about a driver: name, photo, vehicle photo and registration.
    match /driverPublic/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && uid() == id
        && request.resource.data.keys().hasOnly(['name', 'photo', 'vehiclePhoto', 'vehicle', 'reg', 'updatedAt'])
        && request.resource.data.get('photo', '').size() < 300000
        && request.resource.data.get('vehiclePhoto', '').size() < 600000
        && notApprovedAfter(id));
    }

    // A person's saved name and cellphone, so the booking form is filled in on any phone.
    match /profiles/{id} {
      allow read: if signedIn() && uid() == id;
      allow write: if permanent() && uid() == id
        && request.resource.data.keys().hasOnly(['name', 'phone', 'updatedAt'])
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('phone', '').size() <= 30;
    }

    // ---------------- Ratings ----------------
    // One rating per side per completed trip. The ID is the trip's ID plus "_p" (passenger rates the driver)
    // or "_d" (driver rates the passenger). Ratings can't be changed afterwards.
    function ratingDoc(id) { return /databases/$(database)/documents/ratings/$(id); }
    function statsDoc(id) { return /databases/$(database)/documents/ratingStats/$(id); }

    match /ratings/{rid} {
      allow read: if signedIn();
      allow create: if permanent() && validRating(rid);
      allow update: if false;
      allow delete: if isAdmin();

      function validRating(rid) {
        let d = request.resource.data;
        let trip = get(requestDoc(d.tripId)).data;
        return d.keys().hasOnly(['tripId', 'from', 'to', 'role', 'stars', 'comment', 'at'])
          && d.from == uid()
          && d.stars is int && d.stars >= 1 && d.stars <= 5
          && d.get('comment', '') is string && d.get('comment', '').size() <= 300
          && trip.status == 'completed'
          && ((d.role == 'driver' && trip.requesterId == uid() && d.to == trip.driverId && rid == d.tripId + '_p')
            || (d.role == 'passenger' && trip.driverId == uid() && d.to == trip.requesterId && rid == d.tripId + '_d'))
          && getAfter(statsDoc(d.to)).data.lastRating == rid;
      }
    }

    // Each person's running total. It can only grow by exactly one new rating, written at the same time.
    match /ratingStats/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (permanent() && addsOneRating(id));
      allow delete: if isAdmin();

      function addsOneRating(id) {
        let r = request.resource.data.lastRating;
        let rd = getAfter(ratingDoc(r)).data;
        let oldSum = resource == null ? 0 : resource.data.sum;
        let oldCount = resource == null ? 0 : resource.data.count;
        return request.resource.data.keys().hasOnly(['sum', 'count', 'lastRating', 'updatedAt'])
          && !exists(ratingDoc(r))
          && rd.to == id && rd.from == uid()
          && request.resource.data.sum == oldSum + rd.stars
          && request.resource.data.count == oldCount + 1;
      }
    }

    // Credit top-ups, recorded by an owner. Drivers can see their own.
    match /topups/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.driverId == uid());
      allow write: if isAdmin();
    }
  }
}
