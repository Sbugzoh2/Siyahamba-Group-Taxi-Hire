rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // A real account (Google or email), not the automatic browse-only one. Accounts follow people to new phones.
    function permanent() { return signedIn() && request.auth.token.firebase.get('sign_in_provider', '') != 'anonymous'; }
    // Owners are listed in the "admins" collection (added by hand in the Firebase console).
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function driverDoc(id) { return /databases/$(database)/documents/drivers/$(id); }
    function requestDoc(id) { return /databases/$(database)/documents/requests/$(id); }
    function walletDoc(id) { return /databases/$(database)/documents/wallets/$(id); }
    function profileDoc(id) { return /databases/$(database)/documents/profiles/$(id); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Siyahamba's fee: 10% of the trip price. Keep this in step with COMMISSION_PCT in index.html.
    function feeFor(fare) { return fare / 10; }
    // A driver's own changes always leave them "incomplete" or "pending" review, never approved.
    function notApprovedAfter(id) { return getAfter(driverDoc(id)).data.get('vetting', 'incomplete') in ['incomplete', 'pending']; }

    match /admins/{id} {
      allow read: if signedIn() && uid() == id;
      allow write: if false;
    }

    // ---------------- Trip requests ----------------
    match /requests/{id} {
      allow read: if signedIn();

      // A passenger books by paying the full final amount from their wallet in the same write.
      // So every trip drivers can see is already paid and held by Siyahamba.
      allow create: if permanent()
        && request.resource.data.requesterId == uid()
        && request.resource.data.status == 'open'
        && request.resource.data.fare is number && request.resource.data.fare > 0
        && request.resource.data.payMode == 'wallet'
        && request.resource.data.payStatus == 'held'
        && !request.resource.data.keys().hasAny(['commission', 'driverId', 'releasedAt', 'refundedAt', 'passengerConfirmed', 'issue', 'issueStatus', 'commissionDecision', 'offerTo', 'originalFare'])
        && vehicleFits(request.resource.data)
        && exists(walletDoc(uid()))
        && getAfter(walletDoc(uid())).data.balance == get(walletDoc(uid())).data.balance - request.resource.data.fare
        && getAfter(walletDoc(uid())).data.balance >= 0;

      allow update: if isAdmin() || passengerCancels() || passengerConfirms() || raisesIssue()
        || passengerTakesOffer() || passengerUndoesOffer()
        || driverAccepts() || driverMovesOn() || driverGivesBack();
      allow delete: if isAdmin();

      // The group must fit in the vehicle they book. Only buses can be booked as several vehicles.
      function vehicleFits(d) {
        return d.get('vehicle', 'quantum') == 'coach'
          || (d.pax is int && d.pax <= {'seven': 6, 'quantum': 14, 'sprinter': 22, 'midibus': 35}.get(d.get('vehicle', 'quantum'), 0));
      }

      function isPassenger() { return resource.data.requesterId == uid(); }

      function walletAdjusted(by) {
        return resource.data.get('payMode', '') != 'wallet'
          || getAfter(walletDoc(uid())).data.balance == get(walletDoc(uid())).data.balance + by;
      }
      // Before a driver accepts: the full amount goes back to the wallet. After: the owner decides.
      function passengerCancels() {
        return isPassenger() && request.resource.data.status == 'cancelled' && (
          (resource.data.status == 'open'
            && changed().hasOnly(['status', 'payStatus', 'refundedAt', 'updatedAt'])
            && (resource.data.get('payMode', '') != 'wallet' || request.resource.data.payStatus == 'refunded')
            && walletAdjusted(resource.data.fare))
          || (resource.data.status == 'accepted' && changed().hasOnly(['status', 'updatedAt'])));
      }
      // A passenger or the trip's driver reports a problem. The owner replies in the trip's messages.
      function raisesIssue() {
        return changed().hasOnly(['issueStatus', 'issueBy', 'issueAt', 'updatedAt'])
          && request.resource.data.issueStatus == 'open'
          && ((isPassenger() && request.resource.data.issueBy == 'passenger')
            || (resource.data.get('driverId', '') == uid() && request.resource.data.issueBy == 'driver'));
      }
      // The passenger picks a driver's price offer. The wallet pays (or gets back) the difference in the same write.
      function passengerTakesOffer() {
        let off = get(/databases/$(database)/documents/requests/$(id)/offers/$(request.resource.data.offerTo)).data;
        return isPassenger()
          && resource.data.status == 'open'
          && changed().hasOnly(['fare', 'offerTo', 'offerAt', 'originalFare', 'updatedAt'])
          && walletAdjusted(resource.data.fare - request.resource.data.fare)
          && request.resource.data.originalFare == resource.data.get('originalFare', resource.data.fare)
          && request.resource.data.fare == off.amount
          && off.driverId == request.resource.data.offerTo;
      }
      // The passenger changes their mind: back to the original price, open to all drivers.
      function passengerUndoesOffer() {
        return isPassenger()
          && resource.data.status == 'open'
          && resource.data.get('offerTo', '') != ''
          && changed().hasOnly(['fare', 'offerTo', 'offerAt', 'updatedAt'])
          && request.resource.data.offerTo == ''
          && request.resource.data.fare == resource.data.originalFare
          && walletAdjusted(resource.data.fare - request.resource.data.fare);
      }
      // "We arrived safely": the passenger's half of releasing the payment.
      function passengerConfirms() {
        return isPassenger()
          && resource.data.status == 'completed'
          && request.resource.data.passengerConfirmed == true
          && changed().hasOnly(['passengerConfirmed', 'updatedAt']);
      }
      // Accepting a job: approved drivers only, paying exactly 10% from their own credit in the same write.
      function driverAccepts() {
        return permanent()
          && resource.data.status == 'open'
          && (resource.data.get('offerTo', '') == '' || resource.data.offerTo == uid())
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverId == uid()
          && request.resource.data.commission == feeFor(resource.data.fare)
          && changed().hasOnly(['status', 'driverId', 'driverName', 'driverPhone', 'driverVehicle', 'driverReg', 'acceptedAt', 'commission', 'updatedAt'])
          && exists(driverDoc(uid()))
          && get(driverDoc(uid())).data.get('vetting', '') == 'approved'
          && getAfter(driverDoc(uid())).data.credit == get(driverDoc(uid())).data.credit - feeFor(resource.data.fare)
          && getAfter(driverDoc(uid())).data.credit >= 0;
      }

      function driverMovesOn() {
        return resource.data.driverId == uid()
          && changed().hasOnly(['status', 'updatedAt', 'enrouteAt', 'ontripAt', 'completedAt'])
          && ((resource.data.status == 'accepted' && request.resource.data.status == 'enroute')
            || (resource.data.status == 'enroute' && request.resource.data.status == 'ontrip')
            || (resource.data.status == 'ontrip' && request.resource.data.status == 'completed'));
      }

      // Giving a job back reopens it and returns the fee to the driver's credit.
      function driverGivesBack() {
        return resource.data.driverId == uid()
          && resource.data.status == 'accepted'
          && request.resource.data.status == 'open'
          && request.resource.data.driverId == null
          && request.resource.data.commission == null
          && changed().hasOnly(['status', 'driverId', 'driverName', 'driverPhone', 'driverVehicle', 'driverReg', 'commission', 'updatedAt'])
          && getAfter(driverDoc(uid())).data.credit == get(driverDoc(uid())).data.credit + resource.data.get('commission', 0);
      }
    }

    // Price offers from drivers on an open trip. One per driver; the document ID is the driver's account ID.
    match /requests/{rid}/offers/{did} {
      allow read: if signedIn() && (isAdmin() || did == uid() || get(requestDoc(rid)).data.requesterId == uid());
      allow create, update: if permanent() && did == uid()
        && get(driverDoc(uid())).data.get('vetting', '') == 'approved'
        && get(requestDoc(rid)).data.status == 'open'
        && get(requestDoc(rid)).data.get('payStatus', 'unpaid') in ['unpaid', 'held']
        && request.resource.data.keys().hasOnly(['driverId', 'driverName', 'driverReg', 'driverVehicle', 'amount', 'note', 'at'])
        && request.resource.data.driverId == uid()
        && request.resource.data.amount is number
        && request.resource.data.amount >= get(requestDoc(rid)).data.get('originalFare', get(requestDoc(rid)).data.fare) * 0.5
        && request.resource.data.amount <= get(requestDoc(rid)).data.get('originalFare', get(requestDoc(rid)).data.fare) * 3
        && request.resource.data.get('note', '').size() <= 200;
      allow delete: if signedIn() && (isAdmin() || did == uid() || get(requestDoc(rid)).data.requesterId == uid());
    }

    // ---------------- Driver accounts (private: the driver and owners only) ----------------
    match /drivers/{id} {
      allow read: if signedIn() && (uid() == id || isAdmin());
      allow create: if isAdmin() || (permanent() && uid() == id
        && request.resource.data.credit == 0
        && request.resource.data.get('vetting', 'incomplete') in ['incomplete', 'pending']
        && request.resource.data.keys().hasOnly(openKeys().concat(identityKeys()).concat(['credit', 'code', 'createdAt'])));
      allow update: if isAdmin() || (signedIn() && uid() == id && (profileEdit() || payForJob() || refundForJob()));
      allow delete: if isAdmin();

      // Fields a driver can change at any time.
      function openKeys() { return ['phone', 'email', 'assoc', 'race', 'online', 'onlineAt', 'updatedAt']; }
      // Fields the owner checks. Changing any of them sends the driver back for review.
      function identityKeys() {
        return ['name', 'idType', 'idNumber', 'nationality', 'vehicle', 'reg', 'pdp',
          'bankName', 'bankHolder', 'bankAccount', 'bankBranch', 'docs', 'vetting', 'submittedAt', 'consentAt', 'referredBy'];
      }
      function profileEdit() {
        return changed().hasOnly(openKeys().concat(identityKeys()))
          && (!changed().hasAny(identityKeys()) || request.resource.data.get('vetting', 'incomplete') in ['incomplete', 'pending']);
      }
      function payForJob() {
        let job = request.resource.data.lastJob;
        return changed().hasOnly(['credit', 'lastJob', 'updatedAt'])
          && get(requestDoc(job)).data.status == 'open'
          && getAfter(requestDoc(job)).data.status == 'accepted'
          && getAfter(requestDoc(job)).data.driverId == uid()
          && request.resource.data.credit == resource.data.credit - getAfter(requestDoc(job)).data.commission
          && request.resource.data.credit >= 0;
      }
      function refundForJob() {
        let job = request.resource.data.lastJob;
        return changed().hasOnly(['credit', 'lastJob', 'updatedAt'])
          && get(requestDoc(job)).data.status == 'accepted'
          && get(requestDoc(job)).data.driverId == uid()
          && getAfter(requestDoc(job)).data.status == 'open'
          && request.resource.data.credit == resource.data.credit + get(requestDoc(job)).data.get('commission', 0);
      }
    }

    // ID copy, driver's licence and PrDP: the driver and owners only.
    match /driverFiles/{id}/files/{kind} {
      allow read: if signedIn() && (uid() == id || isAdmin());
      allow write: if isAdmin() || (signedIn() && uid() == id
        && kind in ['idCopy', 'licence', 'prdp']
        && request.resource.data.data is string && request.resource.data.data.size() < 1000000
        && notApprovedAfter(id));
    }

    // What passengers may see about a driver: name, photo, vehicle photo and registration.
    match /driverPublic/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && uid() == id
        && request.resource.data.keys().hasOnly(['name', 'photo', 'vehiclePhoto', 'vehicle', 'reg', 'updatedAt'])
        && request.resource.data.get('photo', '').size() < 300000
        && request.resource.data.get('vehiclePhoto', '').size() < 600000
        && notApprovedAfter(id));
    }

    // A person's saved name and cellphone, so the booking form is filled in on any phone.
    match /profiles/{id} {
      allow read: if signedIn() && (uid() == id || isAdmin());
      allow delete: if isAdmin();
      allow create, update: if permanent() && uid() == id
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'emergencyName', 'emergencyPhone', 'updatedAt'])
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('phone', '').size() <= 30;
    }

    // ---------------- Ratings ----------------
    // One rating per side per completed trip. The ID is the trip's ID plus "_p" (passenger rates the driver)
    // or "_d" (driver rates the passenger). Ratings can't be changed afterwards.
    function ratingDoc(id) { return /databases/$(database)/documents/ratings/$(id); }
    function statsDoc(id) { return /databases/$(database)/documents/ratingStats/$(id); }

    match /ratings/{rid} {
      allow read: if signedIn();
      allow create: if permanent() && validRating(rid);
      allow update: if false;
      allow delete: if isAdmin();

      function validRating(rid) {
        let d = request.resource.data;
        let trip = get(requestDoc(d.tripId)).data;
        return d.keys().hasOnly(['tripId', 'from', 'to', 'role', 'stars', 'comment', 'at'])
          && d.from == uid()
          && d.stars is int && d.stars >= 1 && d.stars <= 5
          && d.get('comment', '') is string && d.get('comment', '').size() <= 300
          && trip.status == 'completed'
          && ((d.role == 'driver' && trip.requesterId == uid() && d.to == trip.driverId && rid == d.tripId + '_p')
            || (d.role == 'passenger' && trip.driverId == uid() && d.to == trip.requesterId && rid == d.tripId + '_d'))
          && getAfter(statsDoc(d.to)).data.lastRating == rid;
      }
    }

    // Each person's running total. It can only grow by exactly one new rating, written at the same time.
    match /ratingStats/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (permanent() && addsOneRating(id));
      allow delete: if isAdmin();

      function addsOneRating(id) {
        let r = request.resource.data.lastRating;
        let rd = getAfter(ratingDoc(r)).data;
        let oldSum = resource == null ? 0 : resource.data.sum;
        let oldCount = resource == null ? 0 : resource.data.count;
        return request.resource.data.keys().hasOnly(['sum', 'count', 'lastRating', 'updatedAt'])
          && !exists(ratingDoc(r))
          && rd.to == id && rd.from == uid()
          && request.resource.data.sum == oldSum + rd.stars
          && request.resource.data.count == oldCount + 1;
      }
    }

    // ---------------- Live tracking, trip sharing and SOS ----------------
    function trip(id) { return get(requestDoc(id)).data; }
    function onTrip(id) { return trip(id).requesterId == uid() || trip(id).get('driverId', '') == uid(); }
    function tripActive(id) { return trip(id).status in ['accepted', 'enroute', 'ontrip']; }

    // The taxi's last known position during a trip. Written only by that trip's driver while the trip is on.
    match /tracking/{tripId} {
      allow read: if signedIn() && (isAdmin() || onTrip(tripId)
        || (tripActive(tripId) && exists(/databases/$(database)/documents/shareGrants/$(uid() + '_' + tripId))));
      allow write: if permanent() && trip(tripId).get('driverId', '') == uid() && tripActive(tripId)
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'acc', 'heading', 'speed', 'at', 'driverId'])
        && request.resource.data.driverId == uid()
        && request.resource.data.lat is number && request.resource.data.lng is number;
    }

    // "Share my trip": a secret link the passenger sends to family. The link's code is the document ID.
    match /shares/{token} {
      allow get: if signedIn();
      allow create: if permanent() && token.size() >= 20
        && request.resource.data.keys().hasOnly(['tripId', 'by', 'createdAt'])
        && request.resource.data.by == uid()
        && trip(request.resource.data.tripId).requesterId == uid();
      allow delete: if signedIn() && resource.data.by == uid();
    }
    // Someone who opened a share link may follow that one trip while it's on.
    match /shareGrants/{gid} {
      allow get: if signedIn() && gid == uid() + '_' + resource.data.tripId;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tripId', 'token', 'at'])
        && gid == uid() + '_' + request.resource.data.tripId
        && get(/databases/$(database)/documents/shares/$(request.resource.data.token)).data.tripId == request.resource.data.tripId;
    }

    // SOS alerts from a passenger or driver on a trip. Owners see them all.
    match /sos/{id} {
      allow create: if permanent()
        && request.resource.data.keys().hasOnly(['tripId', 'by', 'role', 'at', 'lat', 'lng', 'note'])
        && request.resource.data.by == uid()
        && onTrip(request.resource.data.tripId);
      allow read: if isAdmin() || (signedIn() && resource.data.by == uid());
      allow update, delete: if isAdmin();
    }

    // ---------------- Passenger wallets ----------------
    // Money only goes in when an owner confirms a top-up. It only moves with the passenger's own trips.
    match /wallets/{id} {
      allow read: if signedIn() && (uid() == id || isAdmin());
      allow create: if isAdmin() || (permanent() && uid() == id
        && request.resource.data.balance == 0
        && request.resource.data.keys().hasOnly(['balance', 'code', 'createdAt', 'updatedAt']));
      allow update: if isAdmin() || (permanent() && uid() == id && tripPayment());
      allow delete: if isAdmin();

      function tripPayment() {
        let t = request.resource.data.lastTrip;
        let after = getAfter(requestDoc(t)).data;
        return changed().hasOnly(['balance', 'lastTrip', 'updatedAt'])
          && request.resource.data.balance >= 0
          && after.requesterId == uid()
          && ((!exists(requestDoc(t)) && request.resource.data.balance == resource.data.balance - after.fare)
            || (exists(requestDoc(t)) && get(requestDoc(t)).data.requesterId == uid() && get(requestDoc(t)).data.status == 'open'
              && ((after.status == 'open' && request.resource.data.balance == resource.data.balance - (after.fare - get(requestDoc(t)).data.fare))
                || (after.status == 'cancelled' && request.resource.data.balance == resource.data.balance + get(requestDoc(t)).data.fare))));
      }
    }
    // "I've sent a top-up": shows on the owner dashboard straight away. Only an owner adds the money.
    match /walletClaims/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == uid());
      allow create: if permanent()
        && request.resource.data.keys().hasOnly(['userId', 'amount', 'ref', 'at', 'status'])
        && request.resource.data.userId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.get('ref', '').size() <= 60;
      allow update, delete: if isAdmin();
    }
    match /walletTopups/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == uid());
      allow write: if isAdmin();
    }

    // ---------------- Messages about a trip (issues and the owner's replies) ----------------
    match /requests/{rid}/messages/{mid} {
      allow read: if signedIn() && (isAdmin() || get(requestDoc(rid)).data.requesterId == uid() || get(requestDoc(rid)).data.get('driverId', '') == uid());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'by', 'text', 'at', 'to'])
        && request.resource.data.by == uid()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && ((request.resource.data.from == 'owner' && isAdmin())
          || (request.resource.data.from == 'passenger' && get(requestDoc(rid)).data.requesterId == uid())
          || (request.resource.data.from == 'driver' && get(requestDoc(rid)).data.get('driverId', '') == uid()));
      allow update, delete: if isAdmin();
    }

    // ---------------- Emails waiting to be sent ----------------
    // Uses the format of Firebase's "Trigger Email from Firestore" extension, set up with "profiles" as the
    // users collection, so emails go to each person's saved address. Without the extension, emails just wait here.
    // Trip participants may queue exactly one receipt per side, addressed only to that side's account.
    match /mail/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || (permanent() && receiptMail(id));
      function receiptMail(id) {
        let d = request.resource.data;
        let t = get(requestDoc(d.tripId)).data;
        return d.keys().hasOnly(['toUids', 'message', 'tripId', 'at', 'kind'])
          && t.status == 'completed'
          && (t.requesterId == uid() || t.get('driverId', '') == uid())
          && ((id == d.tripId + '_receipt_p' && d.toUids == [t.requesterId])
            || (id == d.tripId + '_receipt_d' && d.toUids == [t.driverId]));
      }
    }

    // "Delete my account": the request goes to the owners, who refund any balance and delete the data.
    match /deletionRequests/{id} {
      allow read: if signedIn() && (uid() == id || isAdmin());
      allow create: if permanent() && uid() == id
        && request.resource.data.keys().hasOnly(['at', 'email', 'status', 'reason'])
        && request.resource.data.status == 'pending'
        && request.resource.data.get('reason', '').size() <= 500;
      allow update, delete: if isAdmin();
    }

    // Credit top-ups, recorded by an owner. Drivers can see their own.
    match /topups/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.driverId == uid());
      allow write: if isAdmin();
    }
  }
}
